nextflow_workflow {

    name "Test Subworkflow TAXONOMY2PHYLOGENY"
    script "../main.nf"
    workflow "TAXONOMY2PHYLOGENY"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/taxonomy2phylogeny"
    tag "taxmarker"

    // Fixtures reused directly from the canonical nf-core/test-datasets `modules`
    // branch (data/generic/tax|fasta/taxonomytree_test.*, merged via
    // nf-core/test-datasets#2274) rather than duplicated onto this pipeline's own
    // test-datasets branch: they're generic, tool-agnostic taxonomy/alignment
    // fixtures with no taxmarker-specific content, built for the equivalent
    // nf-core/modules#12977 component this local subworkflow mirrors.
    test("taxonomytree_test - moose model selection") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'generic/tax/taxonomytree_test.tax', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'generic/fasta/taxonomytree_test.fasta', checkIfExists: true),
                    'DNA',
                ])
                input[1] = false
                """
            }
        }

        then {
            assert workflow.success

            def tree       = path(workflow.out.tree[0][1]).text
            def guide_tree = path(workflow.out.guide_tree[0][1]).text
            def model      = path(workflow.out.model[0][1]).text

            assertAll(
                { assert tree.trim().endsWith(';') },
                { assert guide_tree.trim().endsWith(';') },
                { assert tree.contains('sample1') },
                { assert guide_tree.contains('sample1') },
                { assert model.trim() },
            )
        }

    }

    test("taxonomytree_test - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'generic/tax/taxonomytree_test.tax', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'generic/fasta/taxonomytree_test.fasta', checkIfExists: true),
                    'DNA',
                ])
                input[1] = false
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }

    }

}
