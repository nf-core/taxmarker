%%
%% Description of the pipeline's steps, kept current as the pipeline changes.
%% The published maps, nf-core-taxmarker_metro_map_{light,dark}.svg, are drawn by hand in Inkscape:
%% update this file with every change of the steps, and redraw if the change is structural.
%% make_dark_metro_map.py makes the dark SVG from the light one.
%%
%% To compare with an automatic layout (not committed), render it with nf-metro
%% (https://github.com/pinin4fjords/nf-metro; pip install nf-metro, or conda create -n nf-metro -c bioconda nf-metro):
%%   nf-metro render nf-core-taxmarker_metro_map.mmd --theme nfcore --mode light \
%%     --logo ./nf-core-taxmarker_logo_light.png -o /tmp/nf-core-taxmarker_metro_map_light.svg
%%
%% Section layout uses explicit `%%metro grid:` placement (2 rows x 3 cols) rather
%% than relying on nf-metro's automatic fold-threshold line-wrapping, which produces
%% crossing/misordered output on this graph's off-track raxtax-flagged branch.
%%

%%metro title: nf-core/taxmarker
%%metro style: nfcore

%%metro line: main | Main flow | #24B064
%%metro line: unaligned | Unaligned input | #E67E22 | dashed
%%metro line: raxtax_flagged | raxtax-flagged mislabel | #C0392B | dashed
%%metro line: gtdb | GTDB weight translation | #8E44AD | dashed
%%metro line: divided | Divided tree search | #2980B9 | dashed

%%metro file: seq_in | FASTA | Sequences
%%metro file: tax_in | TSV | Taxonomy (optional)
%%metro file: hmm_in | HMM | HMM profile (optional)
%%metro file: gtdb_metadata_in | TSV | GTDB metadata (optional)
%%metro file: mislabels_raxtax_out | TSV | Mislabels (raxtax)
%%metro file: mislabels_out | TSV | Mislabels
%%metro file: ref_out | FASTA | Reference FASTA, N per species
%%metro file: ref_tree_out | NWK | Reference tree
%%metro file: report_out | HTML | MultiQC report

%%metro off_track: mislabels_raxtax_out

%%metro grid: resolve | 0,0
%%metro grid: align | 1,0
%%metro grid: filter | 2,0
%%metro grid: sativa | 0,1
%%metro grid: export | 1,1
%%metro grid: report | 2,1

%%metro process: resolvetaxonomy | RESOLVETAXONOMY
%%metro process: checkname | CHECKNAMECONSISTENCY
%%metro process: emboss | EMBOSS_SEQRET
%%metro process: gtdbweight | GTDBWEIGHTTRANSLATE
%%metro process: weightedclustering | WEIGHTED_CLUSTERING:.*
%%metro process: checkaligned | ENSURE_ALIGNED:CHECKALIGNED
%%metro process: hmmalign | ENSURE_ALIGNED:(HMMER_.*|FIND_CONCATENATE)
%%metro process: mafft | ENSURE_ALIGNED:MAFFT_ALIGN
%%metro process: gapfilter | GAPFILTER
%%metro process: profilecover | PROFILECOVER
%%metro process: raxtax | RAXTAX_PREFILTER:.*
%%metro process: taxonomytree | SWF_SATIVA:TAXONOMYTREE
%%metro process: raxmlng | SWF_SATIVA:.*:RAXMLNG_SEARCH
%%metro process: treedivide | TREEDIVIDE
%%metro process: moose | RAXMLNG_MOOSE
%%metro process: raxmlngparts | DIVIDED_TREE_SEARCH:RAXMLNG_SEARCH
%%metro process: treegraft | TREEGRAFT
%%metro process: raxmlngeval | RAXMLNG_EVALUATE
%%metro process: sepangref | SATIVAEPANG_REFERENCE
%%metro process: sepangloo | SATIVAEPANG_(LOOTASKS|LOOPLACE|MERGEFOLDS)
%%metro process: sepangreport | SATIVAEPANG_(LOOSCORE|MISREPORT)
%%metro process: exportreference | EXPORTREFERENCE
%%metro process: keepnames | KEEPNAMES
%%metro process: raxmlngref | TAXONOMY2PHYLOGENY_REFERENCE:RAXMLNG_SEARCH
%%metro process: refdivided | TAXONOMY2PHYLOGENY_REFERENCE:DIVIDED_TREE_SEARCH:.*
%%metro process: multiqc | MULTIQC

graph LR
    subgraph resolve [Input resolution]
        seq_in[ ]
        tax_in[ ]
        resolvetaxonomy[RESOLVETAXONOMY]
        checkname[CHECKNAMECONSISTENCY]
        seq_in -->|main| resolvetaxonomy
        tax_in -->|main| resolvetaxonomy
        resolvetaxonomy -->|main| checkname
    end

    subgraph align [Alignment]
        emboss[EMBOSS_SEQRET]
        gtdb_metadata_in[ ]
        gtdbweight[GTDBWEIGHTTRANSLATE]
        weightedclustering[WEIGHTED_CLUSTERING]
        raxtax[RAXTAX_PREFILTER]
        checkaligned[CHECKALIGNED]
        mafft[MAFFT]
        hmm_in[ ]
        hmmalign[HMMALIGN]
        mislabels_raxtax_out[ ]
        gtdb_metadata_in -->|gtdb| gtdbweight
        gtdbweight -->|gtdb| weightedclustering
        emboss -->|main| weightedclustering
        weightedclustering -->|main| raxtax
        raxtax -->|main| checkaligned
        raxtax -->|raxtax_flagged| mislabels_raxtax_out
        checkaligned -->|unaligned| mafft
        hmm_in -->|unaligned| hmmalign
        checkaligned -->|unaligned| hmmalign
    end

    subgraph filter [Filtering]
        gapfilter[GAPFILTER]
        profilecover[PROFILECOVER]
    end

    subgraph sativa [SATIVA subworkflow]
        taxonomytree[TAXONOMYTREE]
        raxmlng[RAxML-NG]
        treedivide[TREEDIVIDE]
        moose[MOOSE]
        raxmlngparts[RAxML-NG parts]
        treegraft[TREEGRAFT]
        raxmlngeval[RAxML-NG evaluate]
        sepangref[sativa-epang reference]
        sepangloo[sativa-epang leave-one-out]
        sepangreport[sativa-epang mislabel report]
        mislabels_out[ ]
        taxonomytree -->|main| raxmlng
        taxonomytree -->|divided| treedivide
        treedivide -->|divided| moose
        treedivide -->|divided| raxmlngparts
        moose -->|divided| raxmlngparts
        raxmlngparts -->|divided| treegraft
        treegraft -->|divided| raxmlngeval
        raxmlng -->|main| sepangref
        raxmlngeval -->|divided| sepangref
        sepangref -->|main| sepangloo
        sepangloo -->|main| sepangreport
        sepangreport -->|main| mislabels_out
    end

    subgraph export [Reference export]
        exportreference[EXPORTREFERENCE]
        ref_out[ ]
        keepnames[KEEPNAMES]
        raxmlngref[RAxML-NG]
        refdivided[DIVIDED_TREE_SEARCH]
        ref_tree_out[ ]
        exportreference -->|main| ref_out
        keepnames -->|main| raxmlngref
        keepnames -->|divided| refdivided
        raxmlngref -->|main| ref_tree_out
        refdivided -->|divided| ref_tree_out
    end

    subgraph report [Reporting]
        multiqc[MULTIQC]
        report_out[ ]
        multiqc -->|main| report_out
    end

    checkname -->|main| emboss
    checkaligned -->|main| gapfilter
    hmmalign -->|unaligned| profilecover
    mafft -->|unaligned| gapfilter
    gapfilter -->|main| taxonomytree
    profilecover -->|unaligned| taxonomytree
    sepangreport -->|main| exportreference
    exportreference -->|main| keepnames
    exportreference -->|main| multiqc
