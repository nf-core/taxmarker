nextflow_process {

    name "Test Process SATIVAEPANG_MERGEFOLDS"
    script "../main.nf"
    process "SATIVAEPANG_MERGEFOLDS"

    tag "modules"
    tag "modules_local"
    tag "sativaepang"
    tag "sativaepang/mergefolds"

    test("two shards, one fold each") {

        when {
            process {
                """
                // Two taskdirs as -folds would leave them: each job placed only its
                // own folds, so every fold carries a jplace in exactly one shard.
                def shards = [ [ 'fold_000', 'fold_002' ], [ 'fold_001' ] ].withIndex().collect { folds, i ->
                    def dir = java.nio.file.Files.createTempDirectory("shard\${i}").resolve('test.l1o_tasks')
                    dir.toFile().mkdirs()
                    dir.resolve('manifest.json').toFile().text = '{"folds": 3}'
                    folds.each { fold ->
                        dir.resolve(fold).toFile().mkdirs()
                        dir.resolve("\${fold}/epa_result.jplace").toFile().text = "placed \${fold}"
                    }
                    dir
                }
                input[0] = [ [ id:'test' ], shards ]
                """
            }
        }

        then {
            def taskdir = file(process.out.taskdir[0][1])
            def foldDirs = taskdir.listFiles().findAll { it.isDirectory() }
            def folds = foldDirs.collect { it.name }.sort()
            assert process.success
            assertAll(
                // Every fold from every shard, exactly once, plus the shared manifest.
                { assert folds == [ 'fold_000', 'fold_001', 'fold_002' ] },
                { assert foldDirs.every { new File(it.toString(), "epa_result.jplace").exists() } },
                { assert new File(taskdir.toString(), 'manifest.json').exists() },
                { assert new File(taskdir.toString(), 'fold_001/epa_result.jplace').text == 'placed fold_001' },
            )
        }
    }

    test("shard order does not matter") {

        when {
            process {
                """
                // Same folds, shards handed over in the opposite order: ln -sf across
                // all of them still lands exactly one jplace per fold either way.
                def shards = [ [ 'fold_001' ], [ 'fold_000', 'fold_002' ] ].withIndex().collect { folds, i ->
                    def dir = java.nio.file.Files.createTempDirectory("rev\${i}").resolve('test.l1o_tasks')
                    dir.toFile().mkdirs()
                    dir.resolve('manifest.json').toFile().text = '{"folds": 3}'
                    folds.each { fold ->
                        dir.resolve(fold).toFile().mkdirs()
                        dir.resolve("\${fold}/epa_result.jplace").toFile().text = "placed \${fold}"
                    }
                    dir
                }
                input[0] = [ [ id:'test' ], shards ]
                """
            }
        }

        then {
            def taskdir = file(process.out.taskdir[0][1])
            def foldDirs = taskdir.listFiles().findAll { it.isDirectory() }
            def folds = foldDirs.collect { it.name }.sort()
            assert process.success
            assertAll(
                { assert folds == [ 'fold_000', 'fold_001', 'fold_002' ] },
                { assert foldDirs.every { new File(it.toString(), "epa_result.jplace").exists() } },
                { assert new File(taskdir.toString(), 'fold_002/epa_result.jplace').text == 'placed fold_002' },
            )
        }
    }

    test("two shards, one fold each - stub") {

        options "-stub"

        when {
            process {
                """
                def shards = [ [ 'fold_000' ], [ 'fold_001' ] ].withIndex().collect { folds, i ->
                    def dir = java.nio.file.Files.createTempDirectory("stub\${i}").resolve('test.l1o_tasks')
                    dir.toFile().mkdirs()
                    dir.resolve('manifest.json').toFile().text = '{}'
                    folds.each { fold ->
                        dir.resolve(fold).toFile().mkdirs()
                        dir.resolve("\${fold}/epa_result.jplace").toFile().text = ''
                    }
                    dir
                }
                input[0] = [ [ id:'test' ], shards ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
