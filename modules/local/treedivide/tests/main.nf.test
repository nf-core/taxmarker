nextflow_process {

    name "Test Process TREEDIVIDE"
    script "../main.nf"
    process "TREEDIVIDE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "taxmarker"
    tag "taxmarker/treedivide"

    // The constraint tree is ((a1..a6), (b1..b6), (f1..f12), c1, c2): two ordinary taxa, one flat
    // taxon of twelve direct tip children, and two unplaced tips (26 tips). Built inline, no fixture.
    def inputs = """
        def a = (1..6).collect { 'a' + it }
        def b = (1..6).collect { 'b' + it }
        def f = (1..12).collect { 'f' + it }
        def all = a + b + f + ['c1', 'c2']
        def constraint = File.createTempFile('test', '.nwk')
        constraint.text = '((' + a.join(',') + '),(' + b.join(',') + '),(' + f.join(',') + '),c1,c2);\\n'
        def aln = File.createTempFile('test', '.fasta')
        aln.text = all.collect { '>' + it + '\\n' + 'ACGTACGT' + '\\n' }.join('')
    """

    test("taxmarker - flat taxon and two taxa are divided into parts of at most --max tips") {

        when {
            params {
                module_args = '--max 8 --min 3 --reps 2 --outgroups 2'
            }
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan   = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta  = [process.out.fasta[0][1]].flatten().sort()
            def nwk    = [process.out.constraints[0][1]].flatten().sort()
            def names  = { f -> path(f).text.readLines().findAll { it.startsWith('>') }.collect { it.substring(1) } }
            def members = { f -> names(f) - plan.jobs.find { it.id == new File(f).name - '.fasta' }.outgroups }
            def tipsOf = { f -> path(f).text.findAll(/[A-Za-z][A-Za-z0-9]*/) }
            def covered = fasta.collectMany { names(it) } as Set

            assertAll(
                // The twelve-child flat taxon cannot be cut by closing a child, so its tips are grouped (8 + 4).
                // Then a1-a6 and b1-b6 are each closed into one part, the flat taxon is closed once more, and
                // the root part holds the representatives of those plus c1 and c2.
                { assert plan.jobs.size() == 6 },
                { assert plan.jobs.count { it.root } == 1 },
                { assert plan.jobs.every { it.n <= 8 } },
                { assert plan.jobs.find { it.root }.n == 8 },
                // The part of the representatives of the grouped flat taxon, with its two outgroup tips, is binary:
                // it is handed over as a tree instead (see the resolved test below).
                { assert fasta.size() == 5 },
                { assert nwk.size() == 5 },
                { assert [process.out.resolved[0][1]].flatten().size() == 1 },
                { assert fasta.collect { new File(it).name - '.fasta' } == nwk.collect { new File(it).name - '.nwk' } },
                // A part never holds more than --max tips plus its outgroup tips.
                { assert fasta.every { names(it).size() <= 8 + 2 } },
                // Every input tip is in some part, and no other name appears.
                { assert covered == (((1..6).collect { 'a' + it }) + ((1..6).collect { 'b' + it }) + ((1..12).collect { 'f' + it }) + ['c1', 'c2']) as Set },
                // A part's constraint tree has exactly the tips of its alignment.
                { assert [fasta, nwk].transpose().every { f, n -> names(f) as Set == tipsOf(n) as Set } },
                // Following the constraint tree, f1 is grouped with f2 to f8 and f12 with f9 to f11, so they never meet.
                { assert !fasta.any { members(it).containsAll(['f1', 'f12']) } },
                { assert process.out.findAll { key, val -> key.startsWith('versions') } }
            )
        }
    }

    test("taxmarker - input that fits in one part is not divided") {

        when {
            params {
                module_args = '--max 100'
            }
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan  = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta = [process.out.fasta[0][1]].flatten()

            assertAll(
                { assert plan.jobs.size() == 1 },
                { assert plan.jobs[0].root },
                { assert plan.jobs[0].n == 26 },
                { assert plan.jobs[0].outgroups == [] },
                { assert fasta.size() == 1 },
                { assert path(fasta[0]).text.readLines().count { it.startsWith('>') } == 26 }
            )
        }
    }

    // Same tips, but a phylogeny chooses the parts: the flat taxon is resolved so that f1 pairs with f12,
    // f2 with f11, and so on. Cutting the constraint tree instead groups f1 with f2 to f8.
    test("taxmarker - partition tree decides which tips share a part") {

        when {
            params {
                module_args = '--max 8 --min 3 --reps 2 --outgroups 2'
            }
            process {
                inputs + """
                def ptree = File.createTempFile('test', '.nwk')
                def pairs = (1..6).collect { '(f' + it + ',f' + (13 - it) + ')' }
                ptree.text = '((' + a.join(',') + '),(' + b.join(',') + '),(((' + pairs[0] + ',' + pairs[1] + '),(' + pairs[2] + ',' + pairs[3] + ')),(' + pairs[4] + ',' + pairs[5] + ')),c1,c2);\\n'
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), file(ptree.toString()) ]
                """
            }
        }

        then {
            assert process.success

            def plan  = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta = [process.out.fasta[0][1]].flatten()
            def names = { f -> path(f).text.readLines().findAll { it.startsWith('>') }.collect { it.substring(1) } }
            def members = { f -> names(f) - plan.jobs.find { it.id == new File(f).name - '.fasta' }.outgroups }

            assertAll(
                { assert plan.jobs.every { it.n <= 8 } },
                // f1 and f12 are a cherry of the partition tree, so they are members of the same part.
                { assert fasta.any { members(it).containsAll(['f1', 'f12']) } }
            )
        }
    }

    test("taxmarker - each part and the representatives of its child parts are clades of its constraint tree") {

        when {
            params {
                module_args = '--max 8 --min 3 --reps 2 --outgroups 2'
            }
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan  = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta = [process.out.fasta[0][1]].flatten().sort()
            def nwk   = [process.out.constraints[0][1]].flatten().sort()
            def names = { f -> path(f).text.readLines().findAll { it.startsWith('>') }.collect { it.substring(1) } }
            def job   = { f -> plan.jobs.find { it.id == new File(f).name.replaceAll(/\..*/, '') } }
            def members = { f -> names(f) - job(f).outgroups }
            def clades = { String s ->
                def stack = [[]]
                def out = [] as Set
                s.findAll(/[(),]|[^(),;\s]+/).each { t ->
                    if (t == '(') { stack << [] }
                    else if (t == ')') { def l = stack.remove(stack.size() - 1); out << (l as Set); stack[-1].addAll(l) }
                    else if (t != ',') { stack[-1] << t }
                }
                out
            }
            def cladesOf = { i -> clades(path(nwk[i]).text) }

            assertAll(
                // Every part but the root has its outgroups: distinct, and not among the part's own tips.
                { assert plan.jobs.findAll { !it.root }.every { it.outgroups.size() == 2 && it.outgroups.toSet().size() == 2 } },
                { assert fasta.every { f -> job(f).root || members(f).intersect(job(f).outgroups).isEmpty() } },
                // The part itself is a clade, so the searched tree can be cut at that node.
                { assert fasta.indices.every { i -> job(fasta[i]).root || (members(fasta[i]) as Set) in cladesOf(i) } },
                // The representatives of each closed part are a clade in the parent, so the part can replace them.
                { assert fasta.indices.every { i ->
                    plan.jobs.findAll { c -> !c.root && c.reps.size() >= 2 && members(fasta[i]).containsAll(c.reps) && c.id != job(fasta[i]).id }
                        .every { c -> (c.reps as Set) in cladesOf(i) }
                } },
                // At least one part contains the representatives of a child part, so the assertion above has content.
                { assert fasta.any { f -> plan.jobs.any { c -> !c.root && c.id != job(f).id && members(f).containsAll(c.reps) } } }
            )
        }
    }

    test("taxmarker - a flat taxon that leaves two tips over gives no duplicated sequence") {

        when {
            params {
                module_args = '--max 10'
            }
            process {
                """
                def tips = (1..12).collect { 't' + it }
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = '(' + tips.join(',') + ');\\n'
                def aln = File.createTempFile('test', '.fasta')
                aln.text = tips.collect { '>' + it + '\\n' + 'ACGTACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan  = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta = [process.out.fasta[0][1]].flatten()
            def names = { f -> path(f).text.readLines().findAll { it.startsWith('>') }.collect { it.substring(1) } }

            assertAll(
                // t1-t10 and t11-t12 are grouped; the pair is shorter than --reps 3.
                { assert plan.jobs.size() == 3 },
                { assert plan.jobs.every { it.reps.toSet().size() == it.reps.size() } },
                { assert fasta.every { names(it).toSet().size() == names(it).size() } }
            )
        }
    }

    test("taxmarker - trees with line breaks, comments, quoted names and no final semicolon are read") {

        when {
            params {
                module_args = '--max 100'
            }
            process {
                """
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = "[&R] ( 'a_b' ,\\n a2 ,\\n ( a3:1.5e-2, 'a4', a5 )95:0.2 )\\n"
                def aln = File.createTempFile('test', '.fasta')
                aln.text = ['a_b', 'a2', 'a3', 'a4', 'a5'].collect { '>' + it + '\\n' + 'ACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def tree = path(process.out.constraints[0][1]).text

            assertAll(
                { assert plan.jobs.size() == 1 },
                { assert plan.jobs[0].n == 5 },
                { assert ['a_b', 'a2', 'a3', 'a4', 'a5'].every { tree.contains(it) } },
                { assert !tree.contains("'") }
            )
        }
    }

    test("taxmarker - fails on a malformed constraint tree with a non-zero exit status") {

        when {
            process {
                """
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = '(a1,a2,(a3,a4;\\n'
                def aln = File.createTempFile('test', '.fasta')
                aln.text = ['a1', 'a2', 'a3', 'a4'].collect { '>' + it + '\\n' + 'ACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('terminated with an error exit status')
        }
    }

    test("taxmarker - fails when a sequence name occurs twice in the alignment") {

        when {
            process {
                """
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = '(a1,a2,a3,a4);\\n'
                def aln = File.createTempFile('test', '.fasta')
                aln.text = ['a1', 'a2', 'a3', 'a4', 'a2'].collect { '>' + it + '\\n' + 'ACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('Duplicate sequence name a2')
        }
    }

    test("taxmarker - fails with a clear message when the partition tree conflicts with the constraint tree") {

        when {
            params {
                module_args = '--max 6 --min 2 --reps 2 --outgroups 2'
            }
            process {
                """
                def a = (1..6).collect { 'a' + it }
                def b = (1..6).collect { 'b' + it }
                def c = (1..6).collect { 'c' + it }
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = '((' + a.join(',') + '),(' + b.join(',') + '),(' + c.join(',') + '));\\n'
                def ptree = File.createTempFile('test', '.nwk')
                ptree.text = '(((a1,a2),b1),((a3,a4,a5,a6),(' + b[1..5].join(',') + ')),(' + c.join(',') + '));\\n'
                def aln = File.createTempFile('test', '.fasta')
                aln.text = (a + b + c).collect { '>' + it + '\\n' + 'ACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), file(ptree.toString()) ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('partition tree must not conflict with the constraint tree')
        }
    }

    test("taxmarker - taxa all smaller than --min are still divided into parts of at most --max tips") {

        when {
            params {
                module_args = '--max 11 --min 10 --reps 3 --outgroups 2'
            }
            process {
                """
                def taxa = ['a', 'b', 'c'].collect { t -> (1..8).collect { t + it } }
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = '(' + taxa.collect { '(' + it.join(',') + ')' }.join(',') + ');\\n'
                def aln = File.createTempFile('test', '.fasta')
                aln.text = taxa.flatten().collect { '>' + it + '\\n' + 'ACGTACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan  = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta = [process.out.fasta[0][1]].flatten()
            def names = { f -> path(f).text.readLines().findAll { it.startsWith('>') }.collect { it.substring(1) } }

            assertAll(
                // No eight-tip taxon fits with another within --max, so a is closed as a part although it is below --min.
                // Its three representatives then fit with b (3 + 8), which becomes a part, and the root part holds
                // that part's representatives and c.
                { assert plan.jobs.size() == 3 },
                { assert plan.jobs.count { it.root } == 1 },
                { assert plan.jobs.every { it.n <= 11 } },
                { assert fasta.every { names(it).size() <= 11 + 2 } }
            )
        }
    }

    test("taxmarker - fails when --min or --outgroups would give parts that cannot be grafted") {

        when {
            params {
                module_args = '--min 1'
            }
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('--min must be at least 2')
        }
    }

    test("taxmarker - a part whose constraint tree is fully resolved is handed over as a tree, not searched") {

        when {
            params {
                module_args = '--max 6 --min 4 --reps 3 --outgroups 1'
            }
            process {
                """
                def x = (1..4).collect { 'x' + it }
                def y = (1..12).collect { 'y' + it }
                def constraint = File.createTempFile('test', '.nwk')
                constraint.text = '(((x1,x2),(x3,x4)),(' + y.join(',') + '));\\n'
                def aln = File.createTempFile('test', '.fasta')
                aln.text = (x + y).collect { '>' + it + '\\n' + 'ACGTACGT' + '\\n' }.join('')
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success

            def plan     = new groovy.json.JsonSlurper().parseText(path(process.out.plan[0][1]).text)
            def fasta    = [process.out.fasta[0][1]].flatten()
            def resolved = [process.out.resolved[0][1]].flatten()
            def id       = { f -> new File(f.toString()).name.tokenize('.')[0] }

            assertAll(
                // x1-x4 with one outgroup tip: ((x1,x2),(x3,x4)) plus the outgroup is binary, which RAxML-NG rejects.
                { assert plan.jobs.size() == 5 },
                { assert plan.jobs.findAll { it.resolved }.size() == 1 },
                { assert plan.jobs.find { it.resolved }.n == 4 },
                { assert resolved.size() == 1 },
                { assert id(resolved[0]) == plan.jobs.find { it.resolved }.id },
                { assert path(resolved[0]).text.findAll(/[xy][0-9]+/).size() == 5 },
                // The other two parts are searched as before and have no tree handed over.
                { assert fasta.collect { id(it) } as Set == plan.jobs.findAll { !it.resolved }.collect { it.id } as Set }
            )
        }
    }

    test("taxmarker - stub") {

        options "-stub"

        when {
            params {
                module_args = '--max 8'
            }
            process {
                inputs + """
                input[0] = [ [ id:'test' ], file(aln.toString()), file(constraint.toString()), [] ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.versions_python[0][0] == 'TREEDIVIDE'
            assert snapshot(process.out.fasta, process.out.constraints, process.out.plan).match()
        }
    }

}
