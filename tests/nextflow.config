/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    // pipelines_testdata_base_path is set in nextflow.config; the pipeline's test data
    // currently lives on erikrikarddaniel/test-datasets, not yet upstream in nf-core/test-datasets.
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {
    withName: 'RAXMLNG_SEARCH|.*:DIVIDED_TREE_SEARCH:RAXMLNG_SEARCH' {
        // Pin the ML search to a single thread here (test-time only, not the pipeline's
        // production default): RAxML-NG's own docs note multi-threaded search isn't
        // perfectly reproducible even with a fixed --seed, since thread scheduling
        // affects the search trajectory -- a real run should use whatever cpus its
        // process_high allocation and executor config grant it.
        cpus = 1
    }
}
