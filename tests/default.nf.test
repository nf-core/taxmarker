nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_taxmarker_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    // The two tests below are the same run with the folds split differently, so their
    // mislabels/summary snapshots must be byte-identical. Clustering is skipped in both:
    // it isn't what's under test here, and leaving it out keeps them quick.
    test("-profile test, all folds in one job") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert !new File("$outputDir/sativaepang/mergefolds").exists() },
                { assert workflow.trace.tasks().findAll { it.name.contains('SATIVAEPANG_LOOPLACE') }*.name == ['NFCORE_TAXMARKER:TAXMARKER:SWF_SATIVA:SATIVAEPANG_LOOPLACE (user-alignment)'] },
                { assert snapshot(
                    file("$outputDir/mislabels/user-alignment.mislabels.tsv"),
                    file("$outputDir/sativaepang/user-alignment.summary.txt")
                ).match("one_job") }
            )
        }
    }

    test("-profile test, folds split over several jobs") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                folds_per_job   = 10
            }
        }

        then {
            assert workflow.success
            assertAll(
                // Above one job the merge runs and the shards are not published,
                // see conf/modules.config.
                { assert new File("$outputDir/sativaepang/mergefolds").exists() },
                // Nextflow still creates the publish directory, but nothing lands in it.
                { assert !new File("$outputDir/sativaepang/looplace/user-alignment.l1o_tasks").exists() },
                // Each job's name carries its fold range.
                { assert workflow.trace.tasks().findAll { it.name.contains('SATIVAEPANG_LOOPLACE') }.every { it.name ==~ /.*\(user-alignment (folds \d+-\d+|fold \d+)\)/ } },
                { assert workflow.trace.tasks().findAll { it.name.contains('SATIVAEPANG_LOOPLACE') }.size() > 1 },
                // These two md5s must equal the one_job snapshot above: splitting the
                // folds cannot change a byte of what comes out.
                { assert snapshot(
                    file("$outputDir/mislabels/user-alignment.mislabels.tsv"),
                    file("$outputDir/sativaepang/user-alignment.summary.txt")
                ).match("folds_split") }
            )
        }
    }

    test("-profile test, one fold per job names each job after its fold") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                folds_per_job   = 1
            }
        }

        then {
            assert workflow.success
            def names = workflow.trace.tasks().findAll { it.name.contains('SATIVAEPANG_LOOPLACE') }*.name
            assertAll(
                { assert names.size() > 1 },
                { assert names.every { it ==~ /.*\(user-alignment fold \d+\)/ } },
                { assert names.toSet().size() == names.size() }
            )
        }
    }

    test("-profile test, fixed raxmlng model skips model selection") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                raxmlng_model   = "GTR+G4"
            }
        }

        then {
            assert workflow.success
            def log = new File("$outputDir/raxmlng/user-alignment.raxml.log").text
            assertAll(
                { assert log.contains("--model GTR+G4") },
                { assert !log.contains("Model selection") },
                { assert !log.contains("simplified") },
            )
        }
    }

    test("-profile test, raxmlng fast search") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                raxmlng_fast    = true
            }
        }

        then {
            assert workflow.success
            def log = new File("$outputDir/raxmlng/user-alignment.raxml.log").text
            assertAll(
                { assert log.contains("ML tree search (simplified)") },
                { assert log.contains("Model selection") },
                { assert log.contains("random seed: 42") },
            )
        }
    }

    test("-profile test, raxmlng seed together with the fast search") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                raxmlng_fast    = true
                raxmlng_seed    = 7
            }
        }

        then {
            assert workflow.success
            def log = new File("$outputDir/raxmlng/user-alignment.raxml.log").text
            assertAll(
                { assert log.contains("random seed: 7") },
                { assert log.contains("ML tree search (simplified)") },
            )
        }
    }

    test("-profile test, raxmlng_fast false skips the fast search") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                raxmlng_fast    = false
            }
        }

        then {
            assert workflow.success
            def log = new File("$outputDir/raxmlng/user-alignment.raxml.log").text
            assert !log.contains("ML tree search (simplified)")
        }
    }

    test("-profile test, divided tree search") {

        when {
            params {
                outdir                   = "$outputDir"
                skip_clustering          = true
                raxmlng_model            = "GTR+G4"
                run_divided_tree_search  = true
                tree_part_max_tips       = 15
                tree_part_min_tips       = 2
                tree_part_reps           = 3
                tree_part_outgroups      = 2
            }
        }

        then {
            assert workflow.success
            def log = new File("$outputDir/raxmlng/user-alignment.raxml.log").text
            def searches = workflow.trace.succeeded().findAll { it.name.contains('RAXMLNG_SEARCH') }
            assertAll(
                // The tree and model that reach the placement step come from the evaluation of the grafted tree.
                { assert log.contains("--evaluate") },
                { assert searches.size() > 1 },
                { assert new File("$outputDir/raxmlng/user-alignment.raxml.bestTree").text.trim().endsWith(";") },
                { assert new File("$outputDir/raxmlng/user-alignment.raxml.bestModel").text.startsWith("GTR") },
                { assert new File("$outputDir/mislabels/user-alignment.mislabels.tsv").exists() },
            )
        }
    }

    test("-profile test, divided tree search needs a fixed model") {

        when {
            params {
                outdir                  = "$outputDir"
                skip_clustering         = true
                run_divided_tree_search = true
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("--run_divided_tree_search needs a fixed model")
        }
    }

    test("-profile test, divided tree search needs a fixed model whatever its case") {

        when {
            params {
                outdir                  = "$outputDir"
                skip_clustering         = true
                raxmlng_model           = "dna"
                run_divided_tree_search = true
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("--run_divided_tree_search needs a fixed model")
        }
    }

    test("-profile test, divided tree search needs a fixed model for the reference tree too") {

        when {
            params {
                outdir                  = "$outputDir"
                skip_clustering         = true
                raxmlng_model           = "GTR+G4"
                raxmlng_reference_model = "DNA"
                run_reference           = true
                run_divided_tree_search = true
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("--run_divided_tree_search needs a fixed model")
        }
    }

    test("-profile test, divided tree search needs a fixed model for the reference tree when only --raxmlng_model names a selection") {

        when {
            params {
                outdir                  = "$outputDir"
                skip_clustering         = true
                skip_sativa             = true
                run_reference           = true
                run_divided_tree_search = true
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("--run_divided_tree_search needs a fixed model")
        }
    }

    test("-profile test, divided tree search without a tree to build warns") {

        when {
            params {
                outdir                  = "$outputDir"
                skip_clustering         = true
                skip_sativa             = true
                run_divided_tree_search = true
            }
        }

        then {
            assert workflow.success
            assert new File("$launchDir/meta/nextflow.log").text.contains("WARN  nextflow.Nextflow - --run_divided_tree_search has no effect")
        }
    }
}
