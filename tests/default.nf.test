nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_taxmarker_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    // The two tests below are the same run with the folds split differently, so their
    // mislabels/summary snapshots must be byte-identical. Clustering is skipped in both:
    // it isn't what's under test here, and leaving it out keeps them quick.
    test("-profile test, all folds in one job") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert !new File("$outputDir/sativaepang/mergefolds").exists() },
                { assert snapshot(
                    file("$outputDir/mislabels/user-alignment.mislabels.tsv"),
                    file("$outputDir/sativaepang/user-alignment.summary.txt")
                ).match("one_job") }
            )
        }
    }

    test("-profile test, folds split over several jobs") {

        when {
            params {
                outdir          = "$outputDir"
                skip_clustering = true
                folds_per_job   = 10
            }
        }

        then {
            assert workflow.success
            assertAll(
                // Above one job the merge runs and the shards are not published,
                // see conf/modules.config.
                { assert new File("$outputDir/sativaepang/mergefolds").exists() },
                // Nextflow still creates the publish directory, but nothing lands in it.
                { assert !new File("$outputDir/sativaepang/looplace/user-alignment.l1o_tasks").exists() },
                // These two md5s must equal the one_job snapshot above: splitting the
                // folds cannot change a byte of what comes out.
                { assert snapshot(
                    file("$outputDir/mislabels/user-alignment.mislabels.tsv"),
                    file("$outputDir/sativaepang/user-alignment.summary.txt")
                ).match("folds_split") }
            )
        }
    }
}
