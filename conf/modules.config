/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'VSEARCH_CLUSTER' {
        // --cluster_fast takes the fasta filename as its own immediate argument (the
        // module appends $fasta right after args2), so --id can't sit between them --
        // it goes in ext.args, appended at the very end of the command instead.
        // --uc: full cluster membership, not just centroids -- CLUSTERSELECT needs
        // every member (weight x length-fraction argmax), not VSEARCH's own
        // length-based centroid choice.
        ext.args2 = '--cluster_fast'
        ext.args3 = '--uc'
        ext.args  = { "--id ${params.cluster_identity}" }
    }

    withName: 'RAXTAX' {
        // --skip-exact-matches: without it, a query's exact self-match in the database
        // (query and database are the same file for this pipeline's self-classification
        // prefilter) short-circuits to confidence 1.0 for that record's own declared
        // (possibly wrong) lineage, defeating the whole point of the check.
        ext.args = '--skip-exact-matches'
    }

    withName: 'RAXTAXFILTER' {
        ext.args = { "--filter-rank ${params.raxtax_filter_rank}" }
    }

    withName: 'HMMER_HMMALIGN' {
        // Trims each sequence's own unaligned terminal tails. NOT what restricts
        // output to match-state columns -- that's HMMER_ESLALIMASK below (--trim
        // was mistakenly assumed to do this; confirmed via `hmmalign -h` that it
        // only trims per-sequence tails, not alignment columns).
        ext.args = '--trim'
    }

    withName: 'HMMER_ESLALIMASK' {
        // Mask down to the profile's own match-state columns (the alignment's
        // #=GC RF annotation), discarding insert-state columns -- those exist only
        // to accommodate specific sequences' own insertions, padding every other
        // sequence with extra gap columns there and otherwise deflating GAPFILTER's
        // non-gap-proportion metric for genuinely full-length sequences.
        ext.args = '--rf-is-mask'
    }

    withName: 'HMMER_ESLREFORMAT' {
        // Must be 'afa' (aligned FASTA, keeps gap columns), not 'fasta' (unaligned
        // output, strips them) -- see esl-reformat's own format table (esl-reformat -h).
        ext.args = 'afa'
    }

    withName: 'GAPFILTER' {
        ext.args = { "--min-nongap ${params.min_nongap}" }
    }

    withName: 'PROFILECOVER' {
        ext.args = { "--min-coverage ${params.min_profile_cover}" }
    }

    withName: 'SEQKIT_GREP' {
        // -n matches the whole header line, not just the id -- needed since the
        // pattern targets embedded taxonomy text (e.g. GTDB's `d__Archaea`), not
        // the id itself.
        ext.args = { "-n -r -p '${params.seqgrep}'" }
    }

    withName: 'SATIVAEPANG_LOOTASKS' {
        // SATIVAEPANG_LOOTASKS and SATIVAEPANG_LOOPLACE both publish a *.l1o_tasks
        // directory under the same default sativaepang/ group (see the process{}
        // publishDir formula above) -- without separate paths, LOOPLACE's post-
        // placement copy silently clobbers LOOTASKS's own pre-placement one.
        publishDir = [
            path: { "${params.outdir}/sativaepang/lootasks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SATIVAEPANG_LOOPLACE' {
        // Empty at the default of one job, so the command stays what it was.
        ext.args = { meta.nshards > 1 ? "-folds ${meta.shard}" : '' }
        // See SATIVAEPANG_LOOTASKS above -- same *.l1o_tasks filename collision.
        publishDir = [
            path: { "${params.outdir}/sativaepang/looplace" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SATIVAEPANG_MERGEFOLDS' {
        // Third *.l1o_tasks in the sativaepang/ group -- see SATIVAEPANG_LOOTASKS above.
        publishDir = [
            path: { "${params.outdir}/sativaepang/mergefolds" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
