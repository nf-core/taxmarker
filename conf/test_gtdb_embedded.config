/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running tests against real GTDB data with embedded taxonomy
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same 121 real GTDB r220 archaeal 16S sequences and DupHaloA/DupSulfoA positive
    control as test_gtdb, but --taxonomy is deliberately not set: taxonomy is instead
    derived from --sequences record headers, GTDB's own single-file convention
    (`>id taxonomy;string`). See testdata/gtdb_archaea_16s_combined_aligned.fasta in
    the taxmarker branch of erikrikarddaniel/test-datasets for provenance.

    Use as follows:
        nextflow run nf-core/taxmarker -profile test_gtdb_embedded,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // Multi-threaded search aborts with BRLEN out-of-bounds on the small test alignments.
    withName: 'RAXMLNG_SEARCH' {
        cpus = 1
    }
}

params {
    config_profile_name        = 'GTDB archaea embedded-taxonomy test profile'
    config_profile_description = 'Real GTDB archaeal 16S dataset with taxonomy embedded in FASTA headers, no separate --taxonomy file'

    // Input data -- no `taxonomy`: derived from `sequences` record headers instead.
    sequences = params.pipelines_testdata_base_path + 'taxmarker/testdata/gtdb_archaea_16s_combined_aligned.fasta'
}
