/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/taxmarker -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // Multi-threaded search aborts with BRLEN out-of-bounds on the small test alignments.
    withName: 'RAXMLNG_SEARCH' {
        cpus = 1
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    taxonomy  = params.pipelines_testdata_base_path + 'taxmarker/testdata/sativa_test.tax'
    sequences = params.pipelines_testdata_base_path + 'taxmarker/testdata/sativa_test.phy'

    // sativa_test.{tax,phy} is a minimal fixture built for fast structural testing: most
    // sequences degap down to only a handful of real bases (heavily '?'-padded), which
    // makes raxtax's self-classification effectively noise -- with a
    // species-level raxtax_filter_rank, it flags nearly every sequence as mislabeled,
    // leaving too few survivors for IQTREE to build a tree from at all. Real runs get
    // raxtax by default (see the issue's opt-out design); this fixture just can't
    // support it. RAXTAX/RAXTAXFORMAT/RAXTAXFILTER are covered independently by their
    // own module-level nf-tests regardless.
    skip_raxtax = true

    // Same heavy '?'-padding also means most sequences fall well below the default
    // 0.8 min_nongap threshold ('?' is a gap character for GAPFILTER too) -- skip for
    // the same reason as raxtax above. GAPFILTER is covered independently by its own
    // module-level nf-tests.
    skip_gapfilter = true
}
