/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running tests against real GTDB archaeal 16S data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    121 real 16S sequences from 10 named GTDB r220 archaeal species (a nested
    genus/family/order/class/phylum ladder, plus distant-phylum outgroups), with a
    deliberate swapped-label pair (DupHaloA/DupSulfoA) added as a guaranteed positive
    control. See testdata/gtdb_archaea_16s*.fasta in the taxmarker branch of
    erikrikarddaniel/test-datasets for provenance.

    Unlike sativa_test.*, this fixture has real, full-length sequence content, so it's
    usable for testing raxtax at the default (most specific) rank without the whole
    reference set collapsing.

    Use as follows:
        nextflow run nf-core/taxmarker -profile test_gtdb,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // Multi-threaded search aborts with BRLEN out-of-bounds on the small test alignments.
    withName: 'RAXMLNG_SEARCH' {
        cpus = 1
    }
}

params {
    config_profile_name        = 'GTDB archaea test profile'
    config_profile_description = 'Real GTDB archaeal 16S dataset to check pipeline function on full-length sequences'

    // Input data
    taxonomy  = params.pipelines_testdata_base_path + 'taxmarker/testdata/gtdb_archaea_16s.tax'
    sequences = params.pipelines_testdata_base_path + 'taxmarker/testdata/gtdb_archaea_16s_aligned.fasta'
}
